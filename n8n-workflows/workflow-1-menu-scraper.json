      {
        "parameters": {
          "jsCode": "const responseData = $input.all()[0].json;\n\n// OpenAI format: choices[0].message.content\nconst contentStr = responseData.choices?.[0]?.message?.content;\nif (!contentStr) throw new Error('No content in MiMo response');\n\nconst campus = $('Prepare MiMo Request').all()[0].json.campus || 'Uzumasa';\n\nlet rawText = contentStr.trim();\nlet dishes;\n\n// Try direct parse, then try extracting from markdown fences\ntry {\n  dishes = JSON.parse(rawText);\n} catch(e) {\n  const match = rawText.match(/```(?:json)?\\s*([\\s\\S]*?)```/);\n  if (match) {\n    rawText = match[1].trim();\n    dishes = JSON.parse(rawText);\n  } else {\n    throw new Error('Parse failed: ' + e.message + '\\nRaw: ' + rawText.slice(0, 200));\n  }\n}\n\nif (!Array.isArray(dishes)) throw new Error('Not an array');\n\nconst weekOf = dishes[0]?.menu_date || new Date().toISOString().slice(0, 10);\n\nreturn dishes\n  .filter(d => d.dish_name && d.dish_name.trim() !== '')\n  .map(d => ({\n    campus,\n    week_of: weekOf.slice(0, 10),\n    day_name: d.day_name || null,\n    menu_date: d.menu_date ? d.menu_date.slice(0, 10) : null,\n    category: d.category || null,\n    subcategory: d.subcategory || null,\n    dish_name: d.dish_name,\n    allergens: d.allergens || null,\n    calories: d.calories || null,\n    protein: d.protein || null,\n    fat: d.fat || null,\n    sodium: d.sodium || null,\n  }));"
        },
