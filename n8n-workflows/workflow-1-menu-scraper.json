    {
      "parameters": {
        "method": "=POST",
        "url": "YOUR_DISCORD_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"🚨 **System Alert** | <@722771046125797428>\\n**Service:** University Menu Bot\\n**Status:** Failed to locate menu email\\n**Action Required:** Please verify the Gmail search query or check if the university has delayed the weekly update.\"\n}",
