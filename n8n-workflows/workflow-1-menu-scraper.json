    {
      "parameters": {
        "jsCode": "const content = $input.item.json.content;\n\n// Get campus from the current input item's chain\n// The Claude node receives campus via Prepare PDF node\nconst campus = $input.item.json.campus || \n               $('Prepare PDF for Claude').item.json.campus ||\n               'Unknown';\n\nconst textBlock = content.find(block => block.type === 'text');\nif (!textBlock) throw new Error('No text block in Claude response');\n\nconst rawText = textBlock.text;\n\nlet dishes;\ntry {\n  dishes = JSON.parse(rawText);\n} catch(e) {\n  throw new Error('Parse failed: ' + e.message);\n}\n\nif (!Array.isArray(dishes)) {\n  throw new Error('Not an array');\n}\n\nconst weekOf = dishes[0]?.menu_date || new Date().toISOString().slice(0, 10);\n\nreturn dishes\n  .filter(dish => dish.dish_name && dish.dish_name.trim() !== '')\n  .map(dish => ({\n    campus,\n    week_of: weekOf.substring(0, 10),\n    day_name: dish.day_name || null,\n    menu_date: dish.menu_date ? dish.menu_date.substring(0, 10) : null,\n    category: dish.category || null,\n    subcategory: dish.subcategory || null,\n    dish_name: dish.dish_name,\n    allergens: dish.allergens || null,\n    calories: dish.calories || null,\n    protein: dish.protein || null,\n    fat: dish.fat || null,\n    sodium: dish.sodium || null,\n  }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
