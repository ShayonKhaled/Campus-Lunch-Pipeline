          "jsCode": "const htmlBody = $input.all()[0].json.html || '';\nif (!htmlBody) throw new Error('No HTML body found in email.');\n\nconst hrefPattern = /href=\"(https:\\/\\/kyotogakuen1-my\\.sharepoint\\.com[^\"]+)\"/gi;\nconst links = [];\nlet match;\nwhile ((match = hrefPattern.exec(htmlBody)) !== null) {\n  links.push({ url: match[1], index: match.index });\n}\n\nif (links.length === 0) {\n  throw new Error('No SharePoint links found.');\n}\n\n// Check surrounding context around each link to identify campus.\n// We check AFTER the href too because the Halal link text (\"\u30cf\u30e9\u30eb\u30d5\u30ec\u30f3\u30c9\u30ea\u30fc...\")\n// comes after its href, and we need \"\u30cf\u30e9\u30eb\" to exclude it from Uzumasa.\nfunction getSurrounding(html, idx, before, after) {\n  var s = Math.max(0, idx - before);\n  var e = Math.min(html.length, idx + after);\n  return html.substring(s, e);\n}\n\nfunction isHalal(ctx) {\n  return ctx.indexOf('\u30cf\u30e9\u30eb') !== -1 || ctx.indexOf('Halal') !== -1;\n}\n\n// Uzumasa: prefer English keyword (\"Uzumasa\"), fall back to Japanese (\"\u592a\u79e6\").\n// Exclude the Halal-friendly link whose context touches the Uzumasa header.\nvar uzumasaLink = null;\nfor (var pass = 0; pass < 2 && !uzumasaLink; pass++) {\n  var keyword = pass === 0 ? 'Uzumasa' : '\u592a\u79e6';\n  for (var i = 0; i < links.length && !uzumasaLink; i++) {\n    var ctx = getSurrounding(htmlBody, links[i].index, 200, 100);\n    if (ctx.indexOf(keyword) !== -1 && !isHalal(ctx)) {\n      uzumasaLink = links[i];\n    }\n  }\n}\n\nif (!uzumasaLink) {\n  throw new Error('No Uzumasa campus link found in email.');\n}\n\nreturn [\n  { pdfUrl: uzumasaLink.url, campus: 'Uzumasa' },\n];"
        },
