      },
      {
        "parameters": {
          "jsCode": "const images = $input.all()[0].json.images;\nif (!images || images.length === 0) throw new Error('No images from PDF converter');\n\nconst campus = $('Extract PDF URL').all()[0].json.campus || 'Uzumasa';\n\nconst content = [];\nfor (const img of images) {\n  content.push({\n    type: 'image_url',\n    image_url: {\n      url: 'data:image/jpeg;base64,' + img\n    }\n  });\n}\n\nconst prompt = `Extract the complete weekly lunch menu from these PDF images for Uzumasa campus.\n\nReturn ONLY a valid JSON array, no other text, no markdown, no backticks.\n\nThe menu has these exact sections and subcategories:\n- category: 'Set Meals', subcategory: 'Campus Lunch (1)'\n- category: 'Set Meals', subcategory: 'Campus Lunch (2)'\n- category: 'A La Carte', subcategory: 'A La Carte'\n- category: 'Noodles', subcategory: 'Ramen'\n- category: 'Noodles', subcategory: 'Udon and Soba'\n- category: 'Curry', subcategory: 'Curry'\n- category: 'Sides', subcategory: 'Side Dish A'\n- category: 'Sides', subcategory: 'Side Dish B'\n- category: 'Sides', subcategory: 'Side Dish C'\n- category: 'Sides', subcategory: 'Salad'\n\nEach item must have these exact fields:\n{\n  \"day_name\": \"Monday\",\n  \"menu_date\": \"2026-05-11\",\n  \"category\": \"Set Meals\",\n  \"subcategory\": \"Campus Lunch (1)\",\n  \"dish_name\": \"Hokkaido Corn Croquette and Whitefish Fry\",\n  \"allergens\": \"Milk, Wheat, Shrimp\",\n  \"calories\": 453,\n  \"protein\": 14.8,\n  \"fat\": 21.4,\n  \"sodium\": 2.4\n}\n\nRules:\n- Include ALL days and ALL dishes\n- Use null for any field not shown\n- menu_date must be YYYY-MM-DD format\n- CRITICAL \u2014 The current year is 2026. All menu_date values MUST use 2026 as the year.\n- For Udon and Soba, list each option as a separate item\n- Return ONLY the JSON array, nothing else`;\n\ncontent.push({ type: 'text', text: prompt });\n\nconst weekOf = new Date().toISOString().slice(0, 10);\nreturn { content, campus, weekOf };"
        },
