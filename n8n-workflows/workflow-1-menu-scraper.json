      "id": "709d5011-d218-44d4-b244-739159edb1a7",
      "name": "Email Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        16,
        -48
      ]
    },
    {
      "parameters": {
        "jsCode": "const htmlBody = $input.item.json.html || '';\nif (!htmlBody) throw new Error('No HTML body found in email.');\n\nconst hrefPattern = /href=\"(https:\\/\\/kyotogakuen1-my\\.sharepoint\\.com[^\"]+)\"/gi;\nconst links = [];\nlet match;\nwhile ((match = hrefPattern.exec(htmlBody)) !== null) {\n  links.push(match[1]);\n}\n\nif (links.length === 0) {\n  throw new Error('No SharePoint links found.');\n}\n\n// Only Uzumasa for now\nreturn [\n  { pdfUrl: links[2] || links[0], campus: 'Uzumasa' },\n];"
      },
      "id": "aeb3702d-5499-496b-a0e4-92e0501e0e6a",
      "name": "Extract PDF URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        -128
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.40.99:3456/fetch-pdf",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"url\": \"{{ $json.pdfUrl }}\" }",
        "options": {
          "redirect": {
            "redirect": {
              "maxRedirects": 5
            }
          },
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "9fa9194d-2068-441e-a7b1-4aa71b375d4c",
      "name": "Download PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        -128
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const base64Pdf = $input.item.json.base64Pdf;\nif (!base64Pdf) throw new Error('No PDF returned from fetcher VM');\n\nconst campus = $('Extract PDF URL').item.json.campus || 'Campus';\n\nconst now = new Date();\nconst weekOf = now.toISOString().slice(0, 10);\n\nreturn { base64Pdf, campus, weekOf };"
      },
      "id": "3b10a790-ec3f-4038-8f93-14cc706552d7",
      "name": "Prepare PDF for Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -128
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "anthropic-beta",
              "value": "pdfs-2024-09-25"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 8000,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"document\",\n          \"source\": {\n            \"type\": \"base64\",\n            \"media_type\": \"application/pdf\",\n            \"data\": \"{{ $json.base64Pdf }}\"\n          }\n        },\n        {\n          \"type\": \"text\",\n          \"text\": \"Extract the complete weekly lunch menu from this PDF for Uzumasa campus.\\n\\nReturn ONLY a valid JSON array, no other text, no markdown, no backticks.\\n\\nThe menu has these exact sections and subcategories:\\n- category: 'Set Meals', subcategory: 'Campus Lunch (1)'\\n- category: 'Set Meals', subcategory: 'Campus Lunch (2)'\\n- category: 'A La Carte', subcategory: 'A La Carte'\\n- category: 'Noodles', subcategory: 'Ramen'\\n- category: 'Noodles', subcategory: 'Udon and Soba'\\n- category: 'Sides', subcategory: 'Side Dish A'\\n- category: 'Sides', subcategory: 'Side Dish B'\\n- category: 'Sides', subcategory: 'Side Dish C'\\n- category: 'Sides', subcategory: 'Salad'\\n\\nEach item must have these exact fields:\\n{\\n  \\\"day_name\\\": \\\"Monday\\\",\\n  \\\"menu_date\\\": \\\"2026-05-11\\\",\\n  \\\"category\\\": \\\"Set Meals\\\",\\n  \\\"subcategory\\\": \\\"Campus Lunch (1)\\\",\\n  \\\"dish_name\\\": \\\"Hokkaido Corn Croquette and Whitefish Fry\\\",\\n  \\\"allergens\\\": \\\"Milk, Wheat, Shrimp\\\",\\n  \\\"calories\\\": 453,\\n  \\\"protein\\\": 14.8,\\n  \\\"fat\\\": 21.4,\\n  \\\"sodium\\\": 2.4\\n}\\n\\nRules:\\n- Include ALL days and ALL dishes\\n- Use null for any field not shown\\n- menu_date must be YYYY-MM-DD format\\n- For Udon and Soba, list each option as a separate item\\n- Return ONLY the JSON array, nothing else\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "id": "71d5a49c-c7e3-419b-a9a4-2f61c21da85a",
      "name": "Claude: Extract Menu",
